# Copy to .env.local and fill in. .env.local is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# Production: the POOLED Neon connection string (Vercel's Neon integration sets
# this for you). Local development: any Postgres URL, e.g.
#   postgresql://localhost:5432/cornerstone_dev
# src/lib/db/index.ts picks the Neon HTTP driver for *.neon.tech URLs and
# node-postgres otherwise, so the same code works in both places.
DATABASE_URL=postgresql://localhost:5432/cornerstone_dev

# ── Payload CMS ─────────────────────────────────────────────────────────────
# Payload shares DATABASE_URL with the app but lives in the `payload` Postgres
# schema; drizzle-kit owns `public`. See docs/spikes/payload-schema-coexistence.md.
#
# Required. Generate with: openssl rand -base64 32. Rotating it invalidates
# every admin session and every outstanding password-reset link.
PAYLOAD_SECRET=

# Vercel Blob read/write token, for media uploads in the admin. Set for you by
# Vercel once Blob storage is added to the project. Leave empty locally: the
# storage adapter then falls back to the local filesystem.
#
# The store must be created with PRIVATE access, and the mode cannot be changed
# afterwards — a wrong choice means creating a new store. Our adapter uploads
# with access: 'private', so a public store rejects every upload outright.
# Private is also what makes the gate real: media is reachable only through
# Payload's auth-gated /api/media/file/... route, never from a raw blob URL.
BLOB_READ_WRITE_TOKEN=

# Required for CMS Live Preview. Generate with: openssl rand -hex 32
#
# /api/preview refuses every request when this is unset, and the admin hides
# Live Preview rather than offering a panel that 403s — so leaving it empty
# turns the feature off cleanly instead of half-on. It is not the security
# boundary on its own: Payload puts this value in the preview iframe's src
# where any signed-in editor can read it, so the route also checks the caller's
# `cms_admins` session.
PREVIEW_SECRET=

# Public origin of the app. Used to build the Live Preview iframe URL, and it
# is the origin the front end checks incoming preview messages against — so it
# must be the exact origin /admin is served from, scheme and port included.
#
# Unlike BETTER_AUTH_URL, set this on *every* environment, each to its own URL.
# It falls back to http://localhost:3000, which is wrong on any deploy: live
# preview then points the iframe at the editor's own machine.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
# Use a different value per environment. There is no default — the app refuses
# to boot without it, by design.
BETTER_AUTH_SECRET=

# Public origin of the app. Set it on Vercel for Production; it is also the
# fallback used when a request's host matches none of the allowed hosts.
#
# Previews no longer need this unset-and-hope behaviour: src/lib/auth.ts builds
# `baseURL: { allowedHosts }` from this plus VERCEL_PROJECT_PRODUCTION_URL
# (which Vercel sets for you), scoped to *this project's* preview hostnames
# rather than all of *.vercel.app.
# Production: https://learn.nihongojp.com
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in. Create a Web application OAuth client in Google Cloud, with
# redirect URIs of {origin}/api/auth/callback/google for localhost and
# production — Google matches the full string exactly, so the origin alone will
# save and then fail at sign-in. Leave JavaScript origins empty: the code
# exchange is server-side. Scopes are email/profile/openid, all non-sensitive;
# adding a sensitive one puts the whole app into Google's verification review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which Vercel preview hostnames this app will answer as. Set on Preview.
#
# Production value: cornerstone-*-retros.vercel.app
#
# The whole pattern, not just the project name, so the team slug is pinned too:
# it sits in the middle of the host, so `cornerstone-*.vercel.app` would also
# match a project named `cornerstone` under a different team. It cannot be
# derived either — with a custom domain attached, VERCEL_PROJECT_PRODUCTION_URL
# holds that domain, not anything preview-shaped.
#
# Unset means previews are not trusted and sign-in 403s there — fails closed.
VERCEL_PREVIEW_HOST_PATTERN=

# ── Email ───────────────────────────────────────────────────────────────────
# Not optional any more. Sign-in links and one-time codes go through Resend, so
# email delivery IS the login system: mail that does not arrive is a user who
# cannot sign in and has no way to tell you.
#
# EMAIL_FROM must be on a domain authenticated in Resend (SPF + DKIM). DMARC is
# worth publishing at p=none but is not required below 5,000 messages/day.
RESEND_API_KEY=
# Must be on a domain authenticated in Resend. Production sends from the
# `send.` subdomain so a sending-reputation problem cannot touch the root
# domain: noreply@send.nihongojp.com
EMAIL_FROM=

# Sets Reply-To on every message. EMAIL_FROM cannot receive, so without this a
# user locked out by a spam filter who replies to their sign-in mail reaches
# nobody — the failure this whole area exists to avoid.
#
# Production: support@nihongojp.com. Safe to set before that mailbox exists:
# replies bounce either way today, and this starts working the moment MX records
# are added, with nothing to remember. Receiving on the root domain and sending
# from send.nihongojp.com are independent — adding the mailbox cannot disturb
# SPF/DKIM on the sending subdomain.
SUPPORT_EMAIL=

# Parity check only. Password signup is closed, so `npm run parity` can no
# longer create its own fixture account — hand it an existing, confirmed one.
PARITY_EMAIL=
PARITY_PASSWORD=

# Local development escape hatch. With no Resend credentials the app refuses to
# send rather than failing quietly — set this to 1 to print sign-in links and
# codes to the server console instead.
#
# These log lines ARE working credentials. NODE_ENV != production was too weak
# a gate for that (it is true in CI, on shared boxes, in every test runner), so
# it must be asked for by name, and a production build refuses it outright.
AUTH_DEV_LOG_LINKS=

# Better Auth enables rate limiting on production only, which means a broken
# limiter configuration is invisible in every environment you can see. Set to 1
# to turn it on locally and confirm it writes to the `rate_limit` table.
RATE_LIMIT_IN_DEV=

# Airtable is gone (#20): content is read from Payload through src/lib/content/,
# so AIRTABLE_API_KEY and AIRTABLE_BASE_ID are no longer used. REVALIDATE_SECRET
# went with them — /api/revalidate existed for an Airtable automation to call,
# and Payload runs in this process, so its collection hooks drop the cache tags
# directly. Delete all three from any .env you still have them in.

# ── Pronunciation scoring service ───────────────────────────────────────────
# The wav2vec2 + ffmpeg pipeline can't run in a Vercel function (model weights
# and native binaries exceed the bundle limit, and it must stay warm), so it
# runs as its own container — see services/pronunciation/README.md.
#
# URL: whatever your container host gives you. For local development:
#   cd services/pronunciation && npm run build \
#     && PRONUNCIATION_SERVICE_SECRET=<same value> npm start
#   (first boot downloads ~300MB of weights into .model-cache; the Docker
#    image bakes them in instead)
PRONUNCIATION_SERVICE_URL=http://localhost:5055

# Shared secret between this app and that service — must be IDENTICAL in both.
# Generate with: openssl rand -hex 32
# The service refuses to boot without it and 401s on a mismatch.
PRONUNCIATION_SERVICE_SECRET=

# ── Migration scripts only (never set on Vercel) ────────────────────────────
# Source MongoDB for the one-off data migration in scripts/migrate/.
MONGODB_URI=
