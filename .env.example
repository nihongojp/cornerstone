# Copy to .env.local and fill in. .env.local is gitignored.

# ── Database ────────────────────────────────────────────────────────────────
# Production: the POOLED Neon connection string (Vercel's Neon integration sets
# this for you). Local development: any Postgres URL, e.g.
#   postgresql://localhost:5432/cornerstone_dev
# src/lib/db/index.ts picks the Neon HTTP driver for *.neon.tech URLs and
# node-postgres otherwise, so the same code works in both places.
DATABASE_URL=postgresql://localhost:5432/cornerstone_dev

# ── Auth ────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
# Use a different value per environment. There is no default — the app refuses
# to boot without it, by design.
BETTER_AUTH_SECRET=

# Public origin of the app. Optional on Vercel (VERCEL_URL is used as a
# fallback); set it explicitly in production.
BETTER_AUTH_URL=http://localhost:3000

# ── Email (password reset) ──────────────────────────────────────────────────
# Optional in development: without them, reset links are logged to the server
# console instead of emailed. Required in production.
RESEND_API_KEY=
EMAIL_FROM=

# ── Airtable (lesson + resource content) ────────────────────────────────────
# Personal access token from https://airtable.com/create/tokens
# Scopes: data.records:read (the running app), plus data.records:write only
# while running scripts/migrate/01-content-to-airtable.ts.
# Grant it access to the "Cornerstone Content" base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appMVqVTfpIWVGjgO

# Shared secret for POST /api/revalidate, which the Airtable automation calls
# so author edits go live within seconds instead of waiting out the cache.
# Generate with: openssl rand -hex 16
REVALIDATE_SECRET=

# ── Migration scripts only (never set on Vercel) ────────────────────────────
# Source MongoDB for the one-off data migration in scripts/migrate/.
MONGODB_URI=
