{
  "name": "cornerstone-pronunciation",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "description": "Standalone phoneme-level pronunciation scoring service (wav2vec2 CTC + ffmpeg).",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "prefetch-model": "node scripts/prefetch-model.js"
  },
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
